{
  "functions": {
    "api/cron/publish.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!cron/).*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "30 3 * * *"
    }
  ]
}
